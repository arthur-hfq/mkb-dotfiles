/* ╔══════════════════════════════════════════════════════════════════╗ */
/* ║  [K-CORE] ROFI — SYSTEM DIAGNOSTIC COMMAND PROMPT             ║ */
/* ║  LIST VIEW / 1PX BORDERS / TERMINAL INPUT AESTHETIC           ║ */
/* ╚══════════════════════════════════════════════════════════════════╝ */

configuration {
    display-drun:    "EXEC";
    display-run:     "CMD";
    display-window:  "WIN";
    show-icons:      false;
    font:            "JetBrains Mono 10";
    drun-display-format: "{name}";
}

* {
    bg:              #f4f4f4;
    fg:              #111111;
    border-color:    #111111;
    inactive:        #888888;
    accent:          #0055ff;
    accent-text:     #ffffff;
    urgent:          #ff3300;
    success:         #00aa55;
    separator-color: #a0a0a0;

    background-color: transparent;
    text-color:       @fg;
    spacing:          0;
}

window {
    width:            520px;
    background-color: @bg;
    border:           1px solid;
    border-color:     @border-color;
    border-radius:    0px;
    padding:          0px;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: @bg;
    children:         [ inputbar, message, listview ];
    spacing:          0px;
    padding:          0px;
}

/* ── INPUT BAR: COMMAND PROMPT ────────────────────────────────────── */
inputbar {
    background-color: @fg;
    text-color:       @bg;
    padding:          8px 12px;
    border:           0px 0px 1px 0px solid;
    border-color:     @border-color;
    children:         [ prompt, textbox-prompt-colon, entry ];
    spacing:          0px;
}

prompt {
    text-color:       @accent-text;
    background-color: @accent;
    padding:          2px 8px;
    border-radius:    0px;
}

textbox-prompt-colon {
    expand:           false;
    str:              " > ";
    text-color:       @bg;
}

entry {
    text-color:       @bg;
    placeholder:      "QUERY...";
    placeholder-color: @inactive;
    padding:          2px 4px;
}

/* ── LIST VIEW ────────────────────────────────────────────────────── */
listview {
    background-color: @bg;
    columns:          1;
    lines:            12;
    fixed-height:     true;
    border:           0px;
    spacing:          0px;
    scrollbar:        false;
    padding:          4px 0px;
}

element {
    padding:          6px 12px;
    border:           0px 0px 0px 0px;
    border-color:     @separator-color;
    background-color: @bg;
    text-color:       @fg;
    border-radius:    0px;
}

element normal.normal {
    background-color: @bg;
    text-color:       @fg;
}

element normal.urgent {
    background-color: @bg;
    text-color:       @urgent;
}

element normal.active {
    background-color: @bg;
    text-color:       @accent;
}

element selected.normal {
    background-color: @accent;
    text-color:       @accent-text;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @accent-text;
}

element selected.active {
    background-color: @accent;
    text-color:       @accent-text;
}

element alternate.normal {
    background-color: @bg;
    text-color:       @fg;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    highlight:        bold;
}

element-icon {
    size:             0px;
}

/* ── MESSAGE ──────────────────────────────────────────────────────── */
message {
    background-color: @bg;
    border:           0px 0px 1px 0px solid;
    border-color:     @separator-color;
    padding:          6px 12px;
}

textbox {
    text-color:       @fg;
    background-color: @bg;
}

/* ── SCROLLBAR (DISABLED BUT STYLED) ──────────────────────────────── */
scrollbar {
    width:            0px;
}
